<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

    <!-- Cover Art Thumbnail -->
    <ImageView
        android:id="@+id/novelCover"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_url_bar"
        android:scaleType="centerCrop" />

    <!-- Novel Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/novelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Novel Title"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/novelDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="3:28:54"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/novelProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="96%"
                android:textColor="@color/teal_500"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <android.widget.ProgressBar
                android:id="@+id/novelProgressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:progressTint="@color/teal_500"
                android:progressBackgroundTint="#1AFFFFFF"
                android:max="100"
                android:progress="96" />

        </LinearLayout>

    </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>