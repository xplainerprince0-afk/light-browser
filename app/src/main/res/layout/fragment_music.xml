<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Cover Art & Title Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgCover"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_url_bar"
                android:scaleType="centerCrop"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tvNovelTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select a Novel"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:ellipsize="marquee"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvChapterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:ellipsize="marquee"
                android:singleLine="true" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:thumbTint="@color/purple_500"
                android:progressTint="@color/purple_500"
                android:progressBackgroundTint="#1AFFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Playback Controls with Seek Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeekBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="-10s"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="⏮"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="12dp"
                    android:text="▶"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnPrimary"
                    style="@style/Widget.Material3.Button"
                    app:cornerRadius="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="⏭"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeekForward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="+10s"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Library Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverflow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:text="⋮"
            android:textSize="20sp"
            android:textColor="?attr/colorOnSurface"
            style="@style/Widget.Material3.Button.TextButton"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickLibrary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Pick Library"
            android:textSize="11sp"
            android:textColor="?attr/colorOnPrimaryContainer"
            style="@style/Widget.Material3.Button"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <View android:layout_width="8dp" android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchNovel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Switch Novel"
            android:textSize="11sp"
            android:textColor="?attr/colorOnPrimaryContainer"
            style="@style/Widget.Material3.Button"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <View android:layout_width="8dp" android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Stop"
            android:textSize="11sp"
            android:textColor="?attr/colorOnPrimaryContainer"
            style="@style/Widget.Material3.Button"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Chapters List -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="Chapters"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:padding="4dp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No audiobook library selected\nTap 'Pick Library' to choose a folder\nStructure: Library/Novel/Chapters.mp3 + cover.jpg"
        android:textColor="#66FFFFFF"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Audiobook Player • MediaPlayer • Numeric chapter sorting • Pauses when hidden"
        android:textColor="#44FFFFFF"
        android:textSize="10sp"
        android:gravity="center" />
</LinearLayout>
