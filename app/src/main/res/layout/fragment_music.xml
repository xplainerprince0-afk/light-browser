<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top toolbar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="#14FFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/btnDrawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/teal_200"
                android:textSize="20sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Audiobooks"
                android:textColor="@color/onSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickLibrary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Library"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportFolder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Import"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchNovel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Novels"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Content area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Novel list -->
        <FrameLayout
            android:id="@+id/novelListContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/novelRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp" />

            <TextView
                android:id="@+id/novelEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="No audiobooks yet\n\nTap Library to pick a folder from Sandbox,\nor Import to add files from storage.\n\nStructure: Novel/audio/*.mp3 + cover.jpg"
                android:textColor="@color/onSurfaceVariant"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Player view -->
        <FrameLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/playerCoverBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/playerCover"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_url_bar"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/playerNovelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Novel Title"
                    android:textColor="@color/onSurface"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:ellipsize="marquee"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/playerChapterTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tap a chapter to play"
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:ellipsize="marquee"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/playerProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="0% • 0:00:00"
                    android:textColor="@color/onSurfaceVariant"
                    android:textSize="12sp"
                    android:gravity="center" />

                <SeekBar
                    android:id="@+id/playerSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:thumbTint="@color/teal_500"
                    android:progressTint="@color/teal_500"
                    android:progressBackgroundTint="#1AFFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/playerCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/onSurfaceVariant"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/playerDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/onSurfaceVariant"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playerBtnPrev"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="16dp"
                        android:text="⏮"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:cornerRadius="28dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playerBtnPlay"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginHorizontal="16dp"
                        android:text="▶"
                        android:textSize="24sp"
                        style="@style/Widget.Material3.Button"
                        app:cornerRadius="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/playerBtnNext"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="16dp"
                        android:text="⏭"
                        android:textSize="20sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:cornerRadius="28dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playerBtnChapters"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="Chapters"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
