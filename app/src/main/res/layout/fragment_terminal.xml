<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Terminal"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● idle"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#0D0F1A"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp">

        <ScrollView
            android:id="@+id/svLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C8CDF3"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:lineSpacingExtra="2dp"
                android:text="Welcome to LightBrowser Terminal\nType 'help' for commands\n" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$"
            android:textColor="#A78BFA"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingEnd="8dp" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/bg_url_bar"
            android:hint="help, clear, scripts, history, js &lt;code&gt;"
            android:textColor="@color/white"
            android:textColorHint="#66FFFFFF"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="▶"
            android:textSize="14sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="Clear"
            android:textSize="11sp"
            style="@style/Widget.Material3.Button.TonalButton"
            app:cornerRadius="12dp" />

        <View android:layout_width="8dp" android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="Copy"
            android:textSize="11sp"
            style="@style/Widget.Material3.Button.TonalButton"
            app:cornerRadius="12dp" />

        <View android:layout_width="8dp" android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScripts"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="Scripts"
            android:textSize="11sp"
            style="@style/Widget.Material3.Button.TonalButton"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
