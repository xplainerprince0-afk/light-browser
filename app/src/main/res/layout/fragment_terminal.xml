<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg"
    android:fitsSystemWindows="false">

    <!-- Scrollable terminal output -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/terminal_text"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:lineSpacingExtra="2dp"
            android:text="@string/terminal_welcome" />
    </androidx.core.widget.NestedScrollView>

    <!--
        Combined compact control row:
        Termux-style extra keys + Clear/Copy/Scripts action icons all in one
        horizontally-scrollable row (44dp total height).
        This replaces the old separate 52dp bottom toolbar.
    -->
    <HorizontalScrollView
        android:id="@+id/extraKeysScroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:background="#0D1117"
        android:fadeScrollbars="true">

        <LinearLayout
            android:id="@+id/llExtraKeys"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp">

            <!--
                Extra key buttons are added here dynamically in TerminalFragment.
                After them the fragment also appends the Clear / Copy / Scripts icon buttons.
            -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Input row – Termux-style prompt + real EditText -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="#0A0A0A">

        <TextView
            android:id="@+id/tvPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~ $ "
            android:textColor="@color/terminal_prompt"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingEnd="4dp" />

        <!--
            Real EditText: maxLines+scrollHorizontally instead of deprecated singleLine,
            so tapping anywhere in the typed text moves the cursor to that exact position.
            No textCursorDrawable override — use the system cursor so it's visible.
        -->
        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@color/terminal_text"
            android:paddingVertical="10dp"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:id="@+id/btnHistUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="▲"
            android:textColor="@color/terminal_text_dim"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnHistDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="▼"
            android:textColor="@color/terminal_text_dim"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!--
        Hidden stub views so the binding class still has btnClear / btnCopy / btnScripts
        (the fragment wires them as invisible no-ops; visible equivalents live in llExtraKeys).
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClear"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TextButton"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TextButton"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScripts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        style="@style/Widget.Material3.Button.TextButton"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
