<?xml version="1.0" encoding="utf-8"?>
<!-- item_file.xml: polished file manager row -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="#0DFFFFFF"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground">

        <!-- File type icon -->
        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="@drawable/bg_extra_key"
            android:contentDescription="File icon" />

        <!-- Name + meta -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F0F0F0"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#6688AA"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- More options chevron -->
        <TextView
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#557799"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
