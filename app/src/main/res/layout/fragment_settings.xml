<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/onSurface"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Browser preferences and data"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="13sp" />

        <!-- Browser prefs card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="#14FFFFFF"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Homepage URL"
                        android:textColor="@color/onSurface"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swJs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enable JavaScript"
                    android:textColor="@color/onSurface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDesktop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Desktop mode"
                    android:textColor="@color/onSurface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAdblock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ad blocker"
                    android:textColor="@color/onSurface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dark mode"
                    android:textColor="@color/onSurface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swSaveSiteData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Save site data (stay logged in)"
                    android:textColor="@color/onSurface" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cache pages for faster loading"
                    android:textColor="@color/onSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Engine card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="#14FFFFFF"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Default Search Engine"
                    android:textColor="@color/onSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="12dp" />

                <!-- Radio-style chip group for search engines -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGoogle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@null" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bing"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@null" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDDG"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DuckDuckGo"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@null" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBrave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brave"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@null" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipYahoo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yahoo"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@null" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEcosia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ecosia"
                        style="@style/Widget.Material3.Chip.Filter"
                        app:chipBackgroundColor="@null" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Data management card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="#14FFFFFF"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear cache and cookies"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reset browsing preferences"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/onSurfaceVariant"
            android:textSize="11sp"
            android:text="LightBrowser v2.4 — Material 3, Alpine terminal" />
    </LinearLayout>
</ScrollView>
