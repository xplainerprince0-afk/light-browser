<resources>
    <!-- Material 3 - Dark theme with pill buttons, rounded modals, fluid typography -->
    <style name="Theme.LightBrowser" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_200</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurface">@color/onSurface</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="bottomNavigationStyle">@style/Widget.LightBrowser.BottomNav</item>
        <!-- Material 3 typography -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LightBrowser.TitleLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LightBrowser.Body</item>
    </style>

    <!-- Light theme variant -->
    <style name="Theme.LightBrowser.Light" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_200</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant_light</item>
        <item name="colorOnSurface">@color/onSurface_light</item>
        <item name="colorOnSurfaceVariant">@color/onSurfaceVariant_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="bottomNavigationStyle">@style/Widget.LightBrowser.BottomNav.Light</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LightBrowser.TitleLarge.Light</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LightBrowser.Body.Light</item>
    </style>

    <style name="ShapeAppearance.LightBrowser.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.LightBrowser.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Pill-shaped buttons (24dp) -->
    <style name="Widget.LightBrowser.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.LightBrowser.Button.TonalPill" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.LightBrowser.Card.Pill" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.LightBrowser.Large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#0DFFFFFF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LightBrowser.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LightBrowser.Indicator</item>
    </style>

    <style name="Widget.LightBrowser.BottomNav.Light" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_light</item>
        <item name="itemIconTint">@color/bottom_nav_colors_light</item>
        <item name="itemTextColor">@color/bottom_nav_colors_light</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LightBrowser.Indicator.Light</item>
    </style>

    <style name="Widget.LightBrowser.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/teal_200</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.SmallComponent</item>
    </style>

    <style name="Widget.LightBrowser.Indicator.Light" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/teal_700</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.SmallComponent</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.LightBrowser.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.LightBrowser.TitleLarge.Light" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/onSurface_light</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.LightBrowser.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/onSurfaceVariant</item>
    </style>

    <style name="TextAppearance.LightBrowser.Body.Light" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/onSurfaceVariant_light</item>
    </style>

    <!-- Opaque popup handled via code (ColorDrawable) to avoid missing style -->
</resources>