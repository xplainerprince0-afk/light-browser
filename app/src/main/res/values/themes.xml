<resources>
    <!-- Material 3 - Dark theme with pill buttons, rounded modals, fluid typography -->
    <style name="Theme.LightBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#2A2D4A</item>
        <item name="colorOnPrimaryContainer">#E2E8F0</item>
        <item name="colorSecondary">#A78BFA</item>
        <item name="colorSecondaryContainer">#1E1B4B</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">#1E293B</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="bottomNavigationStyle">@style/Widget.LightBrowser.BottomNav</item>
        <!-- Material 3 typography -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LightBrowser.TitleLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LightBrowser.Body</item>
    </style>

    <style name="ShapeAppearance.LightBrowser.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.LightBrowser.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Pill-shaped buttons (24dp) -->
    <style name="Widget.LightBrowser.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.LightBrowser.Button.TonalPill" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.LightBrowser.Card.Pill" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/ShapeAppearance.LightBrowser.Large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#0DFFFFFF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LightBrowser.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">#E2E8F0</item>
        <item name="itemTextColor">#94A3B8</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LightBrowser.Indicator</item>
    </style>

    <style name="Widget.LightBrowser.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#2A2D4A</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.SmallComponent</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.LightBrowser.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.LightBrowser.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">#94A3B8</item>
    </style>

    <!-- Opaque popup for 3-dot menu (fixes transparent over web page) -->
    <style name="ThemeOverlay.LightBrowser.Popup" parent="ThemeOverlay.Material3.PopupMenu">
        <item name="android:popupBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="popupMenuBackground">@color/surface</item>
    </style>
</resources>
